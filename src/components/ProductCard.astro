---
import { buildWhatsAppLink } from "../data/config";
import type { Product } from "../lib/types";

interface Props {
  product: Product;
}

const { product } = Astro.props;

const formattedPrice =
  typeof product.price === "number"
    ? product.price.toLocaleString("es-AR", { style: "currency", currency: "ARS", maximumFractionDigits: 0 })
    : null;
---

<article
  class="product-card group bg-white rounded-2xl border border-neutral-200 overflow-hidden flex flex-col transition-all duration-200 hover:shadow-lg hover:-translate-y-0.5 hover:border-neutral-300"
  data-category={product.category}
>
  <div class="relative aspect-square bg-gradient-to-br from-neutral-100 to-neutral-200 flex items-center justify-center overflow-hidden">
    <span class="absolute top-2 left-2 bg-white/90 backdrop-blur text-neutral-600 text-[11px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full shadow-sm">
      {product.category}
    </span>
    {
      product.image ? (
        <img
          src={product.image}
          alt={product.name}
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <span class="text-neutral-400 text-sm px-4 text-center">{product.name}</span>
      )
    }
  </div>

  <div class="p-4 flex flex-col gap-1.5 flex-1">
    <h2 class="font-semibold leading-snug line-clamp-2">{product.name}</h2>
    {formattedPrice && <p class="text-neutral-900 font-bold">{formattedPrice}</p>}

    <a
      href={buildWhatsAppLink(product.name)}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-auto pt-3 inline-flex items-center justify-center gap-2 rounded-lg bg-[#25D366] hover:bg-[#1ebe57] text-white text-sm font-medium py-2 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l4.9-1.3A10 10 0 1 0 12 2Zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20Zm4.4-5.9c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.6.1s-.7.8-.8 1c-.2.2-.3.2-.5.1a6.6 6.6 0 0 1-1.9-1.2 7 7 0 0 1-1.3-1.6c-.1-.2 0-.3.1-.5l.4-.4c.1-.1.2-.3.2-.4.1-.2 0-.3 0-.5s-.6-1.5-.9-2c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.2-.9.9-.9 2.2s1 2.6 1.1 2.7c.1.2 2 3 4.8 4.3.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1 0-.1-.2-.2-.4-.3Z" />
      </svg>
      Consultar por WhatsApp
    </a>
  </div>
</article>
