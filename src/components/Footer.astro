---
import { siteConfig } from "../data/config";
import SocialIcons from "./SocialIcons.astro";

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-neutral-200 bg-neutral-50">
  <div class="max-w-6xl mx-auto px-4 py-8 flex flex-col items-center gap-4 text-sm text-neutral-500">
    <SocialIcons class="[&_a]:hover:text-brand" />
    <p class="text-neutral-600 font-medium">{siteConfig.storeName}</p>
    <p>
      © {year} · Desarrollado por{" "}
      {siteConfig.developer.url ? (
        <a href={siteConfig.developer.url} target="_blank" rel="noopener noreferrer" class="underline hover:text-brand">
          {siteConfig.developer.name}
        </a>
      ) : (
        siteConfig.developer.name
      )}
    </p>
  </div>
</footer>
